{
    "name": "@hapi/tlds",
    "version": "1.1.6",
    "description": "TLDS list for domain validation",
    "keywords": [
        "domain",
        "tlds"
    ],
    "license": "BSD-3-Clause",
    "repository": "git://github.com/hapijs/tlds",
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js",
        "./package.json": "./package.json"
    },
    "scripts": {
        "test": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint",
        "fmt": "oxfmt --check",
        "fmt:fix": "oxfmt",
        "build": "tsdown",
        "update-list": "node --loader ts-node/esm .github/scripts/update-list.ts"
    },
    "devDependencies": {
        "@hapi/oxc-plugin": "^1.0.0",
        "@hapi/wreck": "^18.1.0",
        "@types/node": "^22",
        "@vitest/coverage-v8": "^3.2.1",
        "oxfmt": "^0.53.0",
        "oxlint": "^1.68.0",
        "ts-node": "^10.9.2",
        "tsdown": "^0.13.3",
        "typescript": "^5.8.2",
        "vitest": "^3.2.1"
    },
    "engines": {
        "node": ">=22"
    }
}
